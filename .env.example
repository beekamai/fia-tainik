# --- Тайник configuration (copy to .env and fill in) ---

# HTTP port the service listens on.
PORT=3110

# fia.li public API — used for the `/me` auth lookup.
FIALI_BASE_URL=https://api.fia.li

# Billing internal API (service-to-service), for per-plan limits.
BILLING_URL=http://billing:3003

# Shared HMAC secret for S2S signing.
# Leave empty to skip billing lookups (everyone falls back to FREE limits).
INTERNAL_SECRET=

# Redis — Тайник's only datastore.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=https://panel.fia.li

# Optional: how long (seconds) to cache a validated `/me` profile.
AUTH_CACHE_TTL=30
